#!/bin/zsh
# Render a recording or project:  ./render [folder] [--preview] [--trim-start S] [--trim-end S] ...
# With no folder, renders the most recent recording.
set -e
ROOT="${0:A:h}"
if [[ $# -eq 0 || $1 == --* ]]; then
  DATA="${DEMOREC_DATA:-$HOME/Movies/Demo Recorder}"
  LATEST=$(ls -d "$DATA"/recordings/*/ 2>/dev/null | sort | tail -1)
  [[ -z $LATEST ]] && { echo "No recordings yet. Run ./record first."; exit 1; }
  set -- "$LATEST" "$@"
fi
PYTHONPATH="$ROOT" exec "$ROOT/.venv/bin/python" -m demorec.cli render "$@"
